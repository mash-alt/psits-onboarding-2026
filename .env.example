# Firebase Configuration for PSITS Acquaintance Party 2026
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server-only development seed settings (do not use a VITE_ prefix for secrets).
NODE_ENV=development
ALLOW_ADMIN_SEED=true
ALLOW_CORE_SEED=true
ADMIN_SEED_PASSWORD=your_admin_password
GOOGLE_CLOUD_PROJECT=your_project_id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id"}
